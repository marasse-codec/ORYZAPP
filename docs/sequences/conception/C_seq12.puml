@startuml seq_octroi_traitement_conception
title Diagramme de séquence de conception de la partie Traitement de demande et arbitrage commission

skinparam shadowing false
skinparam defaultFontName "Segoe UI", sans-serif
skinparam backgroundColor #FFFFFF
skinparam maxMessageSize 200
skinparam ParticipantPadding 10

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #1A1A1A
}

skinparam participant {
    BackgroundColor #F2F4F4
    BorderColor #1A1A1A
    FontColor #000000
}

skinparam sequence {
    ArrowColor #1A1A1A
    LifeLineBorderColor #1A1A1A
    LifeLineBackgroundColor #F2F4F4
}

autonumber

actor "agentService : Agent" as AgtService
participant "demande : Demande" as Demande
participant "attribution : Attribution" as Attrib
actor "validateur : Agent" as Val
participant "session : SessionCommission" as Session

note over AgtService
  Pré-condition : agentService est authentifié et détient
  le rôle "Agent de service". Il a déjà consulté la liste des
  demandes soumises relevant de son service et sélectionné
  une "demande" précise (recherche/affichage hors scope
  pur métier, cf. diagrammes précédents).
end note

' ============================================================
' 1. Décision de l'agent de service sur la demande sélectionnée
' ============================================================
alt Créer une attribution pour la demande

    create participant "attribution : Attribution" as Attrib
    AgtService -> Attrib : creer(demande, dateCreation, observation)

    loop Pour chaque ligne d'attribution proposée
        create participant "ligneAttrib : LigneAttribution" as LigneAttrib
        Attrib -> LigneAttrib : creer(ligneDemande, quantiteAttribuee, dateRestitutionPrevue)
    end

    note over Attrib
      Attribution créée à l'état "brouillon" :
      pas encore soumise à la commission.
    end note

    ' --------------------------------------------------------
    ' 2. Soumission de l'attribution par l'agent de service
    ' --------------------------------------------------------
    AgtService -> Attrib : soumettre()
    activate Attrib
    Attrib --> AgtService
    deactivate Attrib

    note over Attrib
      Après soumission, l'attribution
      n'est plus modifiable par le service.
    end note

else Rejeter la demande

    AgtService -> Demande : rejeter(motifRejet, dateTraitement)
    activate Demande
    create participant "historique : HistoriqueDemande" as HistDemande
    Demande -> HistDemande : creer(dateChangement, motifRejet)
    Demande --> AgtService
    deactivate Demande

end

' ============================================================
' 3. Arbitrage par la commission (Validateur)
' Pré-condition : une session de commission est déjà ouverte
' (création hors scope de ce diagramme) et le Validateur a
' consulté les attributions soumises relevant de son périmètre.
' ============================================================
alt Valider l'attribution

    Val -> Session : arbitrer(attribution)
    activate Session
    Session -> Attrib : valider(dateValidation)
    activate Attrib
    create participant "histAttrib : HistoriqueAttribution" as HistAttrib
    Attrib -> HistAttrib : creer(dateChangement, "Validée")
    Attrib --> Session
    deactivate Attrib
    Session --> Val
    deactivate Session

    note over Attrib
      Attribution validée, en attente
      de publication par la commission.
    end note

else Annuler l'attribution

    Val -> Session : arbitrer(attribution)
    activate Session
    Session -> Attrib : annuler(dateAnnulation, motifAnnulation)
    activate Attrib
    create participant "histAttrib2 : HistoriqueAttribution" as HistAttrib2
    Attrib -> HistAttrib2 : creer(dateChangement, "Annulée")
    Attrib --> Session
    deactivate Attrib
    Session --> Val
    deactivate Session

end

@enduml