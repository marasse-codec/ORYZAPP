@startuml seq_octroi_traitement_conception
title Diagramme de séquence de conception de la partie Traitement de demande et arbitrage commission

skinparam shadowing false
skinparam defaultFontName "Segoe UI", sans-serif
skinparam backgroundColor #FFFFFF
skinparam maxMessageSize 200
skinparam ParticipantPadding 10

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #1A1A1A
}

skinparam participant {
    BackgroundColor #F2F4F4
    BorderColor #1A1A1A
    FontColor #000000
}

skinparam sequence {
    ArrowColor #1A1A1A
    LifeLineBorderColor #1A1A1A
    LifeLineBackgroundColor #F2F4F4
}

autonumber

actor "Agent de commission : Agent" as AgtCommission

participant "demande : Demande" as Demande
participant "attribution : Attribution" as Attrib

note over AgtCommission
  Pré-condition : agent de commission est authentifié et détient
  la liste des demandes à traiter.
end note

' ============================================================
' 1. Décision de l'agent de service sur la demande sélectionnée
' ============================================================
alt Créer une attribution pour la demande

    create participant "attribution : Attribution" as Attrib
    AgtCommission -> Attrib : creer(demande, dateCreation, observation)

    loop Pour chaque ligne d'attribution proposée
        create participant "ligneAttrib : LigneAttribution" as LigneAttrib
        Attrib -> LigneAttrib : creer(ligneDemande, quantiteAttribuee, dateRestitutionPrevue)
    end

else Rejeter la demande

    AgtCommission -> Demande : rejeter(motifRejet, dateTraitement)
    activate Demande
    Demande --> AgtCommission
    deactivate Demande

end
@enduml