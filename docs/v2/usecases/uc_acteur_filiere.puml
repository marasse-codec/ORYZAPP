@startuml uc_acteur_filiere
title Cas d'utilisation : Acteur de la filière et visiteur
!include ../style.puml
left to right direction

actor "Visiteur" as Visiteur
actor "Acteur de la filière" as Acteur

rectangle "<b>Plateforme ORYZA</b>" {
    usecase "Consulter la vitrine\n(démarche, catalogue)" as UC_Vitrine
    usecase "Accéder à la connexion\n(icône de la vitrine)" as UC_Connexion $NOUVEAU
    usecase "S'inscrire" as UC_Inscrire
    usecase "Suivre ses demandes" as UC_Suivre
    usecase "Fermer son compte\n(désactivation)" as UC_Fermer $NOUVEAU
}

Visiteur --> UC_Vitrine
Visiteur --> UC_Inscrire
Acteur --> UC_Suivre
Acteur --> UC_Fermer
Acteur -|> Visiteur

UC_Connexion .> UC_Vitrine : <<extend>>
@enduml
