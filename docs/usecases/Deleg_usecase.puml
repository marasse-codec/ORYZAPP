@startuml uc_delegue

left to right direction
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam backgroundColor #FFFFFF
skinparam linetype ortho

skinparam actor {
    BackgroundColor #EDF2F7
    BorderColor #2D3748
    BorderThickness 2
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #F7FAFC
    BorderColor #1A202C
    BorderThickness 2
    FontStyle bold
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    BorderThickness 2
    FontStyle bold
    FontColor #2B6CB0
}

!$COLOR_DELEGUE  = DodgerBlue
!$COLOR_VALID    = ForestGreen

actor "Délégué de pôle" as Delegue #$COLOR_DELEGUE
actor "Agent de commission" as AgentCommission #$COLOR_VALID

rectangle "<b>Plateforme de gestion des appuis ORYZA</b>" {
    usecase "Enregistrer et Soumettre une demande d'appui" as UC_Demande
    usecase "Suivre les demandes déposées" as UC_SuiviDemande
    usecase "Enregistrer une session de commission" as UC_SessionComm
    usecase "Enregistrer une attribution" as UC_ValiderAttr
    usecase "Imprimer formulaire d’arbitrage" as UC_ImpForm
    usecase "Imprimer l'état des stocks" as UC_ImpStocks
    usecase "Simuler des attributions" as UC_SimulAttr

}

Delegue --> UC_Demande
Delegue --> UC_SuiviDemande

AgentCommission -u-> UC_SessionComm #$COLOR_VALID
AgentCommission -u-> UC_ValiderAttr #$COLOR_VALID
AgentCommission -u-> UC_ImpForm #$COLOR_VALID
AgentCommission -u-> UC_ImpStocks #$COLOR_VALID
AgentCommission -u-> UC_SimulAttr #$COLOR_VALID
@enduml