@startuml uc_plateforme
left to right direction

' ============================================================
' DÉFINITION DES VARIABLES DE COULEURS (Sans #, couleurs soutenues)
' ============================================================
!$COLOR_VISITEUR  = Orange
!$COLOR_AGENT     = SlateGray
!$COLOR_DELEGUE   = DodgerBlue
!$COLOR_SERV      = DarkViolet
!$COLOR_VALID     = ForestGreen
!$COLOR_CENTRE    = DarkCyan
!$COLOR_ADMIN     = Crimson
!$COLOR_DIR       = DarkSlateBlue
!$COLOR_HORLOGE   = DarkGoldenRod

title <b>Diagramme de cas d'utilisation — Plateforme de gestion des appuis</b>

' ============================================================
' CONFIGURATION
' ============================================================
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam Linetype ortho

skinparam title {
    FontSize 18
    FontStyle bold
    FontColor #1A202C
}

skinparam actor {
    BorderColor #2D3748
    BorderThickness 2
    FontStyle bold
    FontSize 12
}

skinparam usecase {
    BorderColor #1A202C
    BorderThickness 2
    FontStyle bold
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    BorderThickness 3
    FontStyle bold
    FontSize 14
    FontColor #2B6CB0
}

skinparam arrow {
    Thickness 2
    FontSize 10
    FontStyle bold
}

' ============================================================
' ACTEURS DE GAUCHE
' ============================================================
actor "Visiteur" as Visiteur #$COLOR_VISITEUR
actor "Tous les agents" as TousAgents #$COLOR_AGENT
actor "Délégué de pôle" as Delegue #$COLOR_DELEGUE
actor "Agent de service" as AgentService #$COLOR_SERV
actor "Validateur" as Validateur #$COLOR_VALID

' ============================================================
' PLATEFORME CENTRALE
' ============================================================
rectangle "<b>Plateforme de gestion des appuis</b>" as systeme {
    
    rectangle "r" as left {}
    rectangle "r" as right {}

    usecase "Consulter les conditions de dépôt" as UC_ConditionsDepot #$COLOR_VISITEUR
    usecase "S'authentifier" as UC_Auth #$COLOR_AGENT
    
    usecase "Enregistrer et Soumettre une demande d'appui" as UC_Demande #$COLOR_DELEGUE
    usecase "Suivre ses demandes déposées" as UC_SuiviDemande #$COLOR_DELEGUE
    usecase "Consulter les décisions publiées" as UC_DecisionPublique #$COLOR_DELEGUE

    usecase "Enregistrer et soumettre une attribution" as UC_AttrService #$COLOR_SERV
    usecase "Rejeter une demande" as UC_RejeterDemande #$COLOR_SERV

    usecase "Enregistrer une session de commission" as UC_SessionComm #$COLOR_VALID
    usecase "Valider ou rejeter une attribution" as UC_ValiderAttr #$COLOR_VALID
    usecase "Imprimer le formulaire de commission" as UC_ImpForm #$COLOR_VALID
    usecase "Imprimer l'état des stocks" as UC_ImpStocks #$COLOR_VALID
    usecase "Simuler des attributions" as UC_SimulAttr #$COLOR_VALID
    usecase "Enregistrer le résultat de délibération" as UC_ResDelib #$COLOR_VALID
    usecase "Publier les décisions de la commission" as UC_PublierComm #$COLOR_VALID
    usecase "Imprimer les listes de résultats" as UC_ImpRes #$COLOR_VALID
    usecase "Imprimer un bon d'attribution" as UC_ImpBon #$COLOR_VALID

    usecase "Enregistrer un approvisionnement d'appuis" as UC_Appro #$COLOR_CENTRE
    usecase "Enregistrer l'enlèvement d'appuis" as UC_Enlevement #$COLOR_CENTRE
    usecase "Consulter les matériels confiés en cours" as UC_MatosCours #$COLOR_CENTRE
    usecase "Enregistrer la restitution d'un matériel" as UC_Restitution #$COLOR_CENTRE
    usecase "Réintégrer les appuis d'une attribution caduque" as UC_Reintegration #$COLOR_CENTRE

    usecase "Consulter le journal des actions" as UC_Journal #$COLOR_ADMIN
    usecase "Gérer le système" as UC_GererSys #$COLOR_ADMIN
    usecase "Consulter les synthèses d'appuis" as UC_Synthese #$COLOR_ADMIN

    usecase "Émettre les alertes de délai" as UC_Alertes #$COLOR_HORLOGE
}

' ============================================================
' ACTEURS DE DROITE
' ============================================================
actor "Agent de centre" as AgentCentre #$COLOR_CENTRE
actor "Administrateur" as Admin #$COLOR_ADMIN
actor "Direction" as Direction #$COLOR_DIR
actor "Horloge système" as Horloge #$COLOR_HORLOGE

' ============================================================
' RELATIONS MÉTIER
' ============================================================
Visiteur --> UC_ConditionsDepot #$COLOR_VISITEUR
TousAgents --> UC_Auth #$COLOR_AGENT

Delegue --> UC_Demande #$COLOR_DELEGUE
Delegue --> UC_SuiviDemande #$COLOR_DELEGUE
Delegue --> UC_DecisionPublique #$COLOR_DELEGUE

AgentService --> UC_AttrService #$COLOR_SERV
AgentService --> UC_RejeterDemande #$COLOR_SERV

Validateur --> UC_SessionComm #$COLOR_VALID
Validateur --> UC_ValiderAttr #$COLOR_VALID
Validateur --> UC_ImpForm #$COLOR_VALID
Validateur --> UC_ImpStocks #$COLOR_VALID
Validateur --> UC_SimulAttr #$COLOR_VALID
Validateur --> UC_ResDelib #$COLOR_VALID
Validateur --> UC_PublierComm #$COLOR_VALID
Validateur --> UC_ImpRes #$COLOR_VALID
Validateur --> UC_ImpBon #$COLOR_VALID

AgentCentre --> UC_Appro #$COLOR_CENTRE
AgentCentre --> UC_Enlevement #$COLOR_CENTRE
AgentCentre --> UC_MatosCours #$COLOR_CENTRE
AgentCentre --> UC_Restitution #$COLOR_CENTRE
AgentCentre --> UC_Reintegration #$COLOR_CENTRE

Admin --> UC_Journal #$COLOR_ADMIN
Admin --> UC_GererSys #$COLOR_ADMIN
Admin --> UC_Synthese #$COLOR_DIR
Direction --> UC_Synthese #$COLOR_DIR

Horloge --> UC_Alertes #$COLOR_HORLOGE

@enduml