@startuml elab_demande_uml
title Diagramme de Classes UML : Classe utiles pour l'élaboration d'une demande d'appui

skinparam shadowing false
skinparam defaultFontName "Segoe UI", sans-serif
skinparam backgroundColor #FFFFFF

skinparam class {
    BackgroundColor #FFFFFF
    HeaderBackgroundColor #F2F4F4
    BorderColor #1A1A1A
    FontColor #000000
    AttributeFontColor #000000
    MethodFontColor #000000
    FontSize 16
    AttributeFontSize 14
    MethodFontSize 14
    BorderThickness 1.5
}

skinparam arrow {
    Color #1A1A1A
    FontColor #000000
    FontSize 14
}
hide empty members

' ============================================================
' ENTITÉS
' ============================================================

class TypeDemandeur {
  - idTypeDemandeur : Long
  - libelleTypeDemandeur : String
}

class TypePiece {
  - idTypePiece : Long
  - libelleTypePiece : String
}

class Demandeur {
  - idDemandeur : Long
  - nom : String
  - telephone : String
  - email : String
}

class Agent {
  - idAgent : Long
  - matriculeAgent : String
  - nom : String
  - prenoms : String
}

class Departement {
  - idDepartement : Long
  - libelleDepartement : String
}

class Localite {
  - idLocalite : Long
  - libelleLocalite : String
}

class Campagne {
  - idCampagne : Long
  - dateDebutCampagne : Date
  - dateFinCampagne : Date
}

class StatutDemande {
  - idStatutDemande : Long
  - libelleStatutDemande : String
}

class Demande {
  - idDemande : Long
  - dateDemande : Date
  - dateDebutMiseEnPlaceSouhaitee : Date
}

class HistoriqueDemande {
  - idHistorique : Long
  - dateChangement : DateTime
  - commentaire : String
}

Demande "1" *-- "0..*" HistoriqueDemande : entretenir >
StatutDemande "1" -- "0..*" HistoriqueDemande : marquer >


class PieceJustificative {
  - idPieceJustificative : Long
  - cheminFichier : String
}

class TypeSystemeProduction {
  - idTypeSystemeProduction : Long
  - libelleTypeSystemeProduction : String
}

class SystemeProduction {
  - idSystemeProduction : Long
  - superficie : Double
}

class LigneDemande {
  - idLigneDemande : Long
  - quantiteDemandee : Integer
}

class Service {
  - idService : Long
  - libelleService : String
}

class TypeAppui {
  - idTypeAppui : Long
  - libelleTypeAppui : String
}

class ReferenceAppui {
  - idReferenceAppui : Long
  - libelleReferenceAppui : String
  - quantiteEnStock : Integer
  - coutUnitaire : Double
  - quantiteTarifaire : Double
}

class Equipement {
  - idEquipement : Long
  - matriculeEquipement : String
  - etat : String
  - remis : Boolean
  - estEquipement : Boolean

}

ReferenceAppui "1" -r- "0..*" Equipement : inventorier >

' ============================================================
' ASSOCIATIONS
' ============================================================

Demandeur "0..*" -- "1" TypeDemandeur : typer >
TypeDemandeur "0..*" -- "0..*" TypePiece : exiger >

Demandeur "1" -- "0..*" Demande : effectuer >
Agent "1" -- "0..*" Demande : enregistrer >
Demande "0..*" -u- "1" StatutDemande : statuer <
Campagne "1" -- "0..*" Demande : viser <
Campagne -r[hidden]- Demandeur
Localite "1" -l- "0..*" Demande : provenir <
Localite "0..*" -- "1" Departement : situer >

Demande "1" *-- "0..*" PieceJustificative : joindre >
TypePiece "1" -- "0..*" PieceJustificative : couvrir >
Demande "1" *-- "1..*" SystemeProduction : contenir >
TypeSystemeProduction "1" -u- "0..*" SystemeProduction : catégoriser >
Demande "1" *-l- "1..*" LigneDemande : constituer >

LigneDemande "0..*" -d- "1" ReferenceAppui : demander >
TypeAppui "0..*" -l- "1" Service : fournir <
ReferenceAppui "0..*" -d- "1" TypeAppui : classifier <

@enduml