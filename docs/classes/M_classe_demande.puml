@startuml elab_demande_uml
title Diagramme de Classes UML : Classe utiles pour l'élaboration d'une demande d'appui

skinparam shadowing false
skinparam defaultFontName "Segoe UI", sans-serif
skinparam backgroundColor #FFFFFF

skinparam class {
    BackgroundColor #FFFFFF
    HeaderBackgroundColor #F2F4F4
    BorderColor #1A1A1A
    FontColor #000000
    AttributeFontColor #000000
    MethodFontColor #000000
    FontSize 16
    AttributeFontSize 14
    MethodFontSize 14
    BorderThickness 1.5
}

skinparam arrow {
    Color #1A1A1A
    FontColor #000000
    FontSize 14
}
hide empty members

' ============================================================
' ENTITÉS
' ============================================================

class TypeDemande {
  - idTypeDemande : Long
  - libelleTypeDemande : String
}

class TypePiece {
  - idTypePiece : Long
  - libelleTypePiece : String
}

class Demandeur {
  - idDemandeur : Long
  - nom : String
  - telephone : String
  - email : String
}

class Agent {
  - idAgent : Long
  - matriculeAgent : String
  - nom : String
  - prenoms : String
}

class Departement {
  - idDepartement : Long
  - libelleDepartement : String
}

class Localite {
  - idLocalite : Long
  - libelleLocalite : String
}

class Campagne {
  - idCampagne : Long
  - libCampagne : String
  - dateDebutCampagne : Date
  - dateFinCampagne : Date
}

' class StatutDemande {
'   - idStatutDemande : Long
'   - libelleStatutDemande : String
' }

' class HistoriqueDemande {
'   - idHistorique : Long
'   - dateChangement : DateTime
'   - commentaire : String
' }

class Demande {
  - idDemande : Long
  - dateDebutMiseEnPlaceSouhaitee : Date
  - dateFinMiseEnPlaceEsperee: Date
  - dateSoummission: Date
  - dateVisiteTerrain : Date
  - nomDemandeur : String
  - mailDemandeur : String
  - commentaires : String
}

' Demande "1" *-- "0..*" HistoriqueDemande : entretenir >
' StatutDemande "1" -- "0..*" HistoriqueDemande : marquer >

class PieceJustificative {
  - idPieceJustificative : Long
  - cheminFichier : String
}

class TypeSystemeProduction {
  - idTypeSystemeProduction : Long
  - libelleTypeSystemeProduction : String
}

class SystemeProduction {
  - idSystemeProduction : Long
  - superficie : Double
}

class LigneDemande {
  - idLigneDemande : Long
  - quantiteeDemande : int
}

LigneDemande "0..*" - "0..1" ReferenceAppui : "préciser" 

class Service {
  - idService : Long
  - libelleService : String
}

class TypeAppui {
  - idTypeAppui : Long
  - libelleTypeAppui : String
}

class ReferenceAppui {
  - idReferenceAppui : Long
  - libelleReferenceAppui : String
  - quantiteEnStock : Integer
  - coutUnitaire : Double
}

class UniteDosage {
  - idUnite : Long
  - codeUnite : String
  - libUnite : String
}

class Equipement {
  - idEquipement : Long
  - matriculeEquipement : String
  - etat : String
}

ReferenceAppui "1" -- "0..*" Equipement : inventorier >

' ============================================================
' ASSOCIATIONS
' ============================================================

Demande "0..*" -- "1" TypeDemande : typer <
TypeDemande "0..*" -- "0..*" TypePiece : exiger >

Demandeur "1" -- "0..*" Demande : effectuer >
Agent "1" -- "0..*" Demande : enregistrer >
' Demande "0..*" -- "1" StatutDemande : statuer <
Campagne "1" -- "0..*" Demande : viser <
Localite "1" -- "0..*" Demande : provenir <
Localite "0..*" -- "1" Departement : situer >

Demande "1" *-- "0..*" PieceJustificative : joindre >
TypePiece "1" -- "0..*" PieceJustificative : couvrir >
Demande "1" *-- "1..*" SystemeProduction : contenir >
TypeSystemeProduction "1" -- "0..*" SystemeProduction : catégoriser >
Demande "1" *-- "1..*" LigneDemande : constituer <

LigneDemande "0..*" -- "1" TypeAppui : demander >
TypeAppui "0..*" -- "1" Service : fournir <
ReferenceAppui "0..*" -- "1" TypeAppui : classifier <
ReferenceAppui "0..*" -- "1" UniteDosage : avoir <
@enduml