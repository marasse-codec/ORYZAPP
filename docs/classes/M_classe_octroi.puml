class Demande {
  - idDemande : Long
  - dateSoummission : Date
  - dateDebutMiseEnPlaceSouhaitee : Date
  - nomDemandeur : String
  - mailDemandeur : String
}

' class EtapeValidationDemande {
'   - idEtape : Long
'   - libEtape : String
'   - ordre : Int
' }

' Service "1" -l- "1" EtapeValidationDemande : effectuer >

' Demande "1" *-- "0..*" HistoriqueDemande : entretenir >
' StatutDemande "1" -r- "0..*" HistoriqueDemande : marquer >
' Demande "0..*" -- "1" StatutDemande : statuer <

' DateFinTraitement prend la date de fin du dernier copiedemande
' dateSoumission marque qu'on ne peut plus modifier apès soummission

class CopieDemande {
  - observationService : String
  - dateFinTraitement : Date
  - motifRejetService : String
}

CopieDemande "1..*" -d- "1" Demande : entrainer <
CopieDemande "1..*" -l- "1" Service : traiter <
CopieDemande "0..1" -- "0..1" Attribution : produire >

' note top of [Demande]
'   ! Remarque !
'   Ajout de dateTraitement et motifRejet :
'   permettre de suivre l'état de la demande
' end note

class LigneDemande {
  - idLigneDemande : Long
  - quantiteeDemande : Int
}

TypeAppui "1" - "0..*" LigneDemande : demander <

class SessionCommission {
  - idSessionCommission : Long
  - resume : String
  - dateDebutSession : Date
  - dateFinSession : Date
}

class Attribution {
  - idAttribution : Long
  - observation : String
}
 
