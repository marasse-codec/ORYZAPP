@startuml octroi_demande_uml
title Diagramme de classes : Classe utiles pour l'attribution d'appuis et le traitement d'une demande

skinparam shadowing false
skinparam defaultFontName "Segoe UI", sans-serif
' Suppression de tout fond de diagramme (transparent / blanc)
skinparam backgroundColor #FFFFFF

hide empty members

skinparam class {
    BackgroundColor #FFFFFF
    HeaderBackgroundColor #F2F4F4
    BorderColor #1A1A1A
    FontColor #000000
    AttributeFontColor #000000
    MethodFontColor #000000
    FontSize 16
    AttributeFontSize 14
    MethodFontSize 14
    BorderThickness 1.5
}

skinparam arrow {
    Color #1A1A1A
    FontColor #000000
    FontSize 14
}
' ============================================================
' CLASSES
' ============================================================

class Service {
  - idService : Long
  - libelleService : String
}

class TypeAppui {
  - idTypeAppui : Long
  - libelleTypeAppui : String
}

class ReferenceAppui {
  - idReferenceAppui : Long
  - libelleReferenceAppui : String
  - quantiteEnStock : Integer
  - coutUnitaire : Double
  - quantiteTarifaire : Double
}

class Equipement {
  - idEquipement : Long
  - matriculeEquipement : String
  - etat : String
  - remis : Boolean
  - estEquipement : Boolean

}

ReferenceAppui "1" -l- "0..*" Equipement : inventorier >
TypeAppui "0..*" -- "1" Service : fournir <
ReferenceAppui "0..*" -l- "1" TypeAppui : classifier <


class StatutDemande {
  - idStatutDemande : Long
  - libelleStatutDemande : String
}

class Demande {
  - idDemande : Long
  - dateDemande : Date
}

class HistoriqueDemande {
  - idHistorique : Long
  - dateChangement : DateTime
  - commentaire : String
}


Demande "1" *-- "0..*" HistoriqueDemande : entretenir >
StatutDemande "1" -- "0..*" HistoriqueDemande : marquer >

' DateFinTraitement prend la date de fin du dernier traitement
' dateSoumission marque qu'on ne peut plus modifier apès soummission

StatutDemande "1" - "1..*" Demande : statuer >

class Traitement {
  - datePriseEnCharge : Date
  - observationInterne : String
  - dateFinTraitement : Date
  - dateRejetService : Boolean
  - motifRejetService : String
}

Traitement "1..*" -d- "1" Demande : entrainer <
Traitement "1..*" -l- "1" Service : engager <
Traitement "0..1" -- "0..1" Attribution : produire >

' note top of [Demande]
'   ! Remarque !
'   Ajout de dateTraitement et motifRejet :
'   permettre de suivre l'état de la demande
' end note

class LigneDemande {
  - idLigneDemande : Long
}

class SessionCommission {
  - idSessionCommission : Long
  - resume : String
  - dateSession : Date
}

class Attribution {
  - idAttribution : Long
  - observation : String
}

class StatutAttribution {
  - idStatutAttribution : Long
  - libStatutAttribution : String
}

class HistoriqueAttribution {
  - idHistorique : Long
  - dateChangement : DateTime
  - commentaire : String
}

Attribution "1" *-- "0..*" HistoriqueAttribution : posseder >
StatutAttribution "0..1" -- "0..*" HistoriqueAttribution : qualifier >

Attribution "0..*" - "1" StatutAttribution : indiquer <
SessionCommission "1" -- "0..*" Attribution : arbitrer >
Demande "1" - "0..*" Attribution : couvrir <

class LigneAttribution {
  - idLigneAttribution : Long
  - quantiteAttribuee : Integer
  - remise : Double
  - dateRestitutionPrevue : Date
}

LigneAttribution "1..*" -- "1..*" ReferenceAppui : "donner"

' ============================================================
' ASSOCIATIONS
' ============================================================

Demande "1" *-- "1..*" LigneDemande : constituer >

Attribution "1" *-- "1..*" LigneAttribution : comporter >

@enduml